# Database Configuration (Neon PostgreSQL)
# For Vercel deployment, add these to Environment Variables in Vercel Dashboard
DATABASE_URL="postgresql://username:password@host-pooler.region.aws.neon.tech/database?sslmode=require&connection_limit=10&pool_timeout=30&connect_timeout=60"
DIRECT_URL="postgresql://username:password@host.region.aws.neon.tech/database?sslmode=require"

# Next Auth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-key-min-32-characters"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google AI API Key for nutrition estimation (optional)
GOOGLE_API_KEY="your-google-ai-api-key"
